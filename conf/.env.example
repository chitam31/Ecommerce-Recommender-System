# conf/.env.example - mọi biến môi trường của dự án ở một chỗ (mục A.5 đề cương). KHÔNG đưa .env thật lên Git.
#
# Trên cụm, các tệp .env thật được SINH TỰ ĐỘNG, không sửa tay:
#   cau_hinh/cum.env               danh bạ máy (IP, vai trò, lõi, RAM) - nguồn duy nhất
#   scripts/cum/khoi_dong_may.sh   sinh ha_tang/{hadoop,spark,kafka,web}/.env từ cum.env cho từng máy
#   scripts/cum/tao_cau_hinh_airflow.sh  sinh ha_tang/airflow/.env và mat_khau.json trên master
# Tệp này liệt kê các biến đó để dựng lại hệ thống ở môi trường khác.

# ---- Địa chỉ cụm (cau_hinh/cum.env)
SPARK_MASTER_IP=10.68.71.113
HDFS_GOC=hdfs://10.68.71.113:8020
KAFKA_BROKER=10.68.71.204:9092
# Gốc hồ dữ liệu trên HDFS theo mục A.4: hdfs:///lakehouse/<ma_de_tai>/
LAKE_DUONG_DAN=/lakehouse/bd03_khuyen_nghi
# Chỉ đặt khi chạy thử ngoài cụm (ghi đè cả scheme + đường dẫn), ví dụ:
# LAKE_GOC=file:///tmp/lake
# Số bản sao HDFS cho tệp mới (2 khi các máy nối thẳng, 1 khi ZeroTier phải đi relay)
HE_SO_SAO_CHEP=2

# ---- Từng máy (ha_tang/*/.env do khoi_dong_may.sh sinh)
NODE_IP=10.68.71.113
SO_LOI=10
BO_NHO=5g

# ---- Web (ha_tang/web/.env)
WEB_CHE_DO=delta            # delta = đọc cụm thật | gia = dữ liệu giả lập, không cần cụm
WEB_KAFKA=bat               # bat | tat (chỉ ghi log khi thử giao diện)
AIRFLOW_URL=http://10.68.71.113:8088
AIRFLOW_USER=admin
AIRFLOW_PASS=               # mật khẩu Airflow: chỉ để trong ha_tang/web/.env.rieng trên máy web

# ---- Airflow (ha_tang/airflow/.env, xem ha_tang/airflow/.env.mau)
BD03_HOST_DIR=/home/hduser/bd03_khuyen_nghi
AIRFLOW_UID=1000
DOCKER_GID=999
AIRFLOW__API_AUTH__JWT_SECRET=thay_bang_chuoi_ngau_nhien   # openssl rand -hex 32
AIRFLOW__CORE__FERNET_KEY=
