# Danh bạ cụm: nguồn sự thật duy nhất về 8 máy trong mạng ZeroTier ttunet.
# IP lấy từ ZeroTier Central (network 633e31d8a29b038c).
#
# Định dạng MAY_<n>="ten|ip_zerotier|vai_tro|so_loi|bo_nho_worker"
# vai_tro ghép bằng dấu phẩy: namenode, datanode, spark-master, spark-worker, kafka, airflow, web
#
# Số đo thật ngày 10/11/2026 (scripts/cum/khao_sat_may.sh): cả 6 máy lab đều 12 lõi, 7 GB RAM.
# RAM là giới hạn chính. bo_nho_worker = phần RAM giao cho executor Spark, sau khi chừa
# khoảng 2 GB cho Ubuntu có giao diện, 1 GB cho DataNode và RAM của các dịch vụ khác trên máy.
# so_loi để thấp hơn 12 vì mỗi lõi chạy một task, quá nhiều task sẽ chia nhỏ RAM của executor.

MAY_1="labsoe-11|10.68.71.113|namenode,spark-master,airflow|0|0"
MAY_2="labsit12|10.68.71.198|datanode,spark-worker|8|3g"
# labsit chạy thêm Kafka (giới hạn 1,5 GB) và kafka-ui (512 MB).
MAY_3="labsit|10.68.71.204|datanode,spark-worker,kafka|6|2g"
# labsit-may25 đang chạy ứng dụng của nhóm khác (coffeehouse-face, PostgreSQL, MySQL, RabbitMQ):
# chỉ lấy ít RAM. Nếu máy chậm hoặc bị thiếu RAM, bỏ vai trò spark-worker của máy này.
MAY_4="labsit-may25|10.68.71.42|datanode,spark-worker|4|2g"
# labsit-may26 có container airflow-worker-kafka của nhóm khác: không dừng container đó.
MAY_5="labsit-may26|10.68.71.90|datanode,spark-worker|8|3g"
MAY_6="labsoe-18|10.68.71.149|datanode,spark-worker,web|8|3g"
# Ctam = Ubuntu WSL2 trong laptop whitehathacker. Từng chạy web; 11/11 chuyển web sang labsoe-18 vì WSL
# (3,8 GB RAM, laptop còn ít RAM trống) sập hai lần lúc build/bật web. Giữ lại làm máy dự phòng.
MAY_7="ctam|10.68.71.205|du-phong|0|0"
# Máy Windows cá nhân: chỉ dùng trình duyệt để mở web demo và các trang giám sát.
MAY_8="personal-windows|10.68.71.59|may-demo|0|0"
# Laptop Windows của Lê Chí Tâm (ZeroTier 354f36a46a): máy điều khiển cụm qua SSH và trình chiếu.
MAY_9="whitehathacker|10.68.71.182|may-demo|0|0"

# Tài khoản đăng nhập SSH của từng máy (whoami), dùng cho scripts/cum/ssh_tat_ca.sh --tao-config.
# Máy chưa có trong danh sách nhận tài khoản mặc định hduser.
TAI_KHOAN_SSH="labsoe-11=hduser labsit12=labsit12 labsit=labsit labsit-may25=labsit labsit-may26=labsit labsoe-18=labsoe-18"

SPARK_MASTER_IP=10.68.71.113
HDFS_GOC=hdfs://10.68.71.113:8020
KAFKA_BROKER=10.68.71.204:9092

# Project docker compose của HDFS trên từng máy, để dùng lại đúng volume dữ liệu cũ. Một số worker
# từng chạy từ thư mục hadoop-custom nên volume tên hadoop-custom_worker_data. Máy không có
# trong danh sách dùng hadoop-cluster (cũng là tên trên máy master).
DU_AN_HADOOP="labsit12=hadoop-custom labsit-may25=hadoop-custom labsit-may26=hadoop-custom"

# Số bản sao HDFS cho tệp mới (cả HDFS lẫn mọi job Spark). Khi các máy nối thẳng với nhau
# (cáp mạng hoặc cùng mạng Wi-Fi cho phép), đặt 2 để mất một máy vẫn còn dữ liệu. Khi ZeroTier
# phải đi đường chuyển tiếp (đo ngày 10/11/2026: khoảng 0,4 MB/s) thì đặt 1: executor ghi bản
# duy nhất xuống chính DataNode của máy mình, không phải chép qua đường chậm.
# 10/11/2026 13:15: cả cụm chung Wi-Fi LabSoe, tải giữa các máy khoảng 3 MB/s, đổi sang 2. Với 1
# bản sao, một DataNode chập chờn làm job hỏng hẳn (thong_ke_san_pham lỗi đọc HDFS hết 60 giây,
# cả 4 lần thử đều đọc trúng một máy); với 2 bản sao, HDFS client tự chuyển sang bản còn lại.
HE_SO_SAO_CHEP=2

# Giới hạn tài nguyên cho job lô và ALS, xem ha_tang/spark/submit.sh.
# Tổng RAM executor của cụm: 3+2+2+3+3 = 13 GB; 3 luồng streaming giữ khoảng 2,5 GB.
# RAM một executor (2g) phải nhỏ hơn bo_nho_worker nhỏ nhất (2g), nếu không worker đó
# không nhận được executor nào.
LOI_LO=8
RAM_LO=2g
LOI_ALS=10
RAM_ALS=2g


