# Sao chép thành .env rồi sửa. KHÔNG đưa .env lên Git.
# Đường dẫn tuyệt đối của thư mục dự án trên máy master
BD03_HOST_DIR=/home/hduser/bd03_khuyen_nghi
# id -u của tài khoản sở hữu thư mục dự án: container Airflow chạy bằng uid này để ghi được vào đó
AIRFLOW_UID=1000
# getent group docker | cut -d: -f3
DOCKER_GID=999
# Khóa ký JWT dùng chung giữa các tiến trình Airflow: tạo bằng  openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=thay_bang_chuoi_ngau_nhien
AIRFLOW__CORE__FERNET_KEY=
SPARK_MASTER_IP=10.68.71.113
